{
  "name": "algorithm-visualization-project",
  "version": "1.0.0",
  "description": "An educational tool that helps users understand the logic and behavior of classic algorithms through step-by-step visualizations, pseudocode synchronization, and a \"Test Yourself\" interactive mode. The platform is designed to promote active learning, reinforce key algorithmic concepts, and allow for user interaction at each stage.",
  "repository": {
    "type": "git",
    "url": "https://gitlab.csi.miamioh.edu/2026-senior-design-projects/algorithm-visualization-project/algorithm-visualization-project.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "clean": "rimraf build screenshots",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest",
    "lint": "eslint .",
    "update-deps": "npm-check-updates -u && npm install",
    "force-update-deps": "npm-check-updates -u && rimraf node_modules .react-router package-lock.json && npm install",
    "update-nvmrc": "node --version > .nvmrc",
    "build-g4": "rimraf app/hooks/interpreter/generated && npx antlr-ng -Dlanguage=TypeScript -v -o app/hooks/interpreter/generated app/hooks/interpreter/Pseudocode.g4"
  },
  "dependencies": {
    "@material-tailwind/react": "^3.0.0-beta.24",
    "@monaco-editor/react": "^4.8.0-rc.2",
    "@react-router/node": "^7.13.0",
    "@react-router/serve": "^7.13.0",
    "iconoir-react": "^7.11.0",
    "isbot": "^5.1.34",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.1",
    "@react-router/dev": "^7.13.0",
    "@stylistic/eslint-plugin": "^5.7.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.0.18",
    "antlr4ng": "^3.0.16",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.3.0",
    "npm-check-updates": "^19.3.2",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18",
    "vitest-browser-react": "^2.0.5"
  },
  "overrides": {
    "@tanstack/react-ranger": {
      "react": "$react"
    }
  }
}

{
  "name": "algorithm-visualization-project",
  "version": "1.0.0",
  "description": "An educational tool that helps users understand the logic and behavior of classic algorithms through step-by-step visualizations, pseudocode synchronization, and a \"Test Yourself\" interactive mode. The platform is designed to promote active learning, reinforce key algorithmic concepts, and allow for user interaction at each stage.",
  "repository": {
    "type": "git",
    "url": "https://gitlab.csi.miamioh.edu/2026-senior-design-projects/algorithm-visualization-project/algorithm-visualization-project.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "clean": "rimraf build screenshots",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest",
    "lint": "eslint .",
    "update-deps": "npm-check-updates -u && npm install",
    "force-update-deps": "npm-check-updates -u && rimraf node_modules .react-router package-lock.json && npm install",
    "update-nvmrc": "node --version > .nvmrc"
  },
  "dependencies": {
    "@material-tailwind/react": "^3.0.0-beta.24",
    "@react-router/node": "^7.9.5",
    "@react-router/serve": "^7.9.5",
    "iconoir-react": "^7.11.0",
    "isbot": "^5.1.32",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@react-router/dev": "^7.9.5",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/browser-playwright": "^4.0.7",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "npm-check-updates": "^19.1.2",
    "rimraf": "^6.1.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.7",
    "vitest-browser-react": "^2.0.2"
  },
  "overrides": {
    "@tanstack/react-ranger": {
      "react": "$react"
    }
  }
}

// Linear Search

a1 = arr[1, 10, 5, 6, 4, 7, 19]
key = 7

// Finds the first occurence of an element in an array
fun Linear_Search(@init<table> a, k):
    n = length(a)

    @mark<outline, orange> for (i = 0, i < n, i += 1):
        @mark<i, text, fg> if (a[i] == k):
            @mark<-999, text> @mark<-999, outline, orange> @mark<i, highlight, green> @log<green, "The key was found at index " + i> return i
        end if
    end for

    @mark<-999, text> @mark<-999, outline, orange> @log<error, "The key was not found in the array"> return -1
end fun

result = Linear_Search(a1, key)

// Check Unique

a1 = arr[1, 2, 3, 4, 5, 3]

// Determines if all elements of an array are unique
fun check_unique(@init<table> array):
    n = length(array)

    @mark<outline, orange> for (i = 0, i < n, i += 1):
        @mark<-999, text> @mark<outline, blue> for (j = i + 1, j < n, j += 1):
            @mark<j, text> if (array[i] == array[j]):
                @mark<-999, text> @mark<i, greyout> @mark<j, greyout> @log<error, "Duplicate found!"> return "Duplicate found!"
            end if
        end for
    end for

    @mark<-999, outline, orange> @mark<-999, outline, blue> @log<green, "Duplicate not found!"> return "Duplicate not found!"
end fun

result = check_unique(a1)
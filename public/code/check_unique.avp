// Check Unique

a1 = arr[1, 2, 3, 4, 5, 3]

// Determines if all elements of an array are unique
fun check_unique(@init<table> array):
    n = length(array)
    
    for (i = 0; i < n; i += 1):
        for (j = i + 1; j < n; j += 1):
            if (i == j):
                return 0  // Duplicate found
            end if
        end for
    end for

    return 1  // No duplicates found
end fun

result = check_unique(a1)
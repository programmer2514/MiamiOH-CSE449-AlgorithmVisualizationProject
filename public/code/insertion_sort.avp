// Insertion Sort

a1 = arr[19, 10, 5, 6, 4, 7, 1]

// Sorts an array of values in ascending order
fun Insertion_Sort(@init<table> array): 
    n = length(array)

    // Starting from 2nd element (index 1) as the first is assumed sorted
    @mark<-999, highlight, green> @mark<-999, outline, blue> @mark<-999, outline, orange> for (i = 1, i < n, i += 1):
        @mark<i, outline, orange> @log<blue, "key = " + key> key = array[i]

        // Compare key with each element to its left
        @mark<-999, text> @mark<-999, highlight, green> @mark<outline, blue> for (j = i - 1, j >= 0, j -= 1):
            // If smaller element is found, we're in the right place
            @mark<j, text> if array[j] <= key:
                break
            end if

            // Otherwise, shift element to the right to keep sorted order
            @mark<j, text, fg, "-->"> @mark<j + 1, highlight, green> array[j + 1] = array[j]
        end for

        // Place key at the correct position in sorted sub-array
        @mark<j + 1, highlight, green> array[j + 1] = key
    end for

    @log<green, "The array is in order!"> return array
end fun

result = Insertion_Sort(a1)
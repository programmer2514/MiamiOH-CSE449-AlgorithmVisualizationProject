// Binary Search

a1 = arr[1 to 12]
key = 11

// Finds an element in a sorted array
fun Binary_Search(@init<table> collection, target, size): 
    @mark<low, outline, orange> low = 0
    @mark<high, outline, blue> high = size - 1

    @mark<-999, text> @log<> while (low <= high):
        // Calculate middle index
        @mark<mid, highlight, yellow> mid = floor((low + high) / 2)
        
        // Get value at the middle
        val = collection[mid]
        
        @mark<mid, text> if (val < target):
            @mark<mid, greyout> @mark<-999, highlight, yellow> @mark<low, outline, orange> low = mid + 1
        else if (val > target):
            @mark<mid, greyout> @mark<-999, highlight, yellow> @mark<high, outline, blue> high = mid - 1
        else:
            @mark<-999, outline, orange> @mark<-999, outline, blue> @mark<-999, text> @mark<-999, highlight, yellow> @mark<mid, highlight, green> @log<green, "The key was found at index " + mid> return mid
        end if
    end while

    @log<error, "The key was not found in the array"> @mark<-999, text> @mark<-999, outline, orange> @mark<-999, outline, blue> @mark<-999, highlight, yellow> @mark<mid, highlight, red> return -1
end fun

result = Binary_Search(a1, key, length(a1))
// Binary Search
fun binary_search(collection, target, size): 
    low = 0
    high = size - 1

    while (low <= high):
        // Calculate middle index
        mid = (low + high) / 2
        
        // Get value at the middle
        val = collection[mid]
        
        if (val == target):
            return mid
        end if
        
        if (val < target):
            low = mid + 1
        end if
        
        if (val > target):
            high = mid - 1
        end if
    end while

    return -1
end fun
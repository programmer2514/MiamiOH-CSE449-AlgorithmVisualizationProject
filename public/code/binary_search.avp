// Binary Search

a1 = arr[1, 3, 5, 7, 9, 11, 19]
key = 11

// Finds an element in a sorted array
fun Binary_Search(@init<table> collection, target, size): 
    @mark<low, outline, orange> low = 0
    @mark<high, outline, blue> high = size - 1

    while (low <= high):
        // Calculate middle index
        @mark<mid, highlight, yellow> mid = floor((low + high) / 2)
        
        // Get value at the middle
        @mark<mid, highlight, yellow> val = collection[mid]
        
        if (val < target):
            @mark<mid, greyout> @mark<low, outline, orange> low = mid + 1
        else if (val > target):
            @mark<mid, greyout> @mark<high, outline, blue> high = mid - 1
        else:
            @mark<mid, highlight, green> return mid
        end if
    end while

    @log<error, "The key was not found in the array"> @mark<mid, highlight, red> return -1
end fun

result = Binary_Search(a1, key, length(a1))
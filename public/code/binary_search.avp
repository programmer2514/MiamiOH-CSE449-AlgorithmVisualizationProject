// Binary Search

a1 = arr[1, 3, 5, 7, 9, 11, 19]
key = 11

fun Binary_Search(collection, target, size): 
    low = 0
    high = size - 1

    while (low <= high):
        // Calculate middle index
        mid = (low + high) / 2
        
        // Get value at the middle
        val = collection[mid]
        
        if (val == target):
            return mid
        end if
        
        if (val < target):
            low = mid + 1
        end if
        
        if (val > target):
            high = mid - 1
        end if
    end while

    return -1
end fun

result = Binary_Search(a1, key, length(a1))
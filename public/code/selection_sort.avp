// selection sort

a1 = arr[1, 10, 5, 6, 4, 7, 19]

fun Selection_Sort(arr): 
    n = length(arr)

    // Outer loop: iterate thru all index positions except the last
    for (i = 0, i < n - 1, i += 1):
        // assume the current index position holds min element
        minIdx = i

        // Inner loop: find actual minimum element in remaining
        // unsorted portion of array
        for (j = i + 1; j < n; j += 1):
            if (arr[j] < arr[minIdx]):
                minIdx = j; // new minimum value index found
            end if
        end for

        // Swap Values when a smaller value is encountered
        swap(arr[i], arr[minIdx])

    end for
end fun

// -----------------------------------------------------------------
//          START OF DO NOT MODIFY THIS FUNCTION SECTION
// -----------------------------------------------------------------

fun swap(itemA, itemB): 
    temp = itemA
    itemA = itemB
    itemB = temp

end fun
// -----------------------------------------------------------------
//          END OF DO NOT MODIFY THIS FUNCTION SECTION
// -----------------------------------------------------------------


result = Selection_Sort(a1)
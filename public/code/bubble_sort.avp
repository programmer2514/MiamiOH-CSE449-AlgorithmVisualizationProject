// bubble sort

a1 = arr[1, 10, 5, 6, 4, 7, 19]

fun Bubble_Sort(arr): 
    n = length(arr)
    swapped = false

    for (i = 0, i < n, i += 1):
        for (j = 0, j < n - i - 1, j += 1):
            if (arr[j] > arr[j + 1]):
                swap (arr[j], arr[j+1])
            end if
        end for
    end for
end fun

// -----------------------------------------------------------------
//          START OF DO NOT MODIFY THIS FUNCTION SECTION
// -----------------------------------------------------------------

fun swap(itemA, itemB): 
    temp = itemA
    itemA = itemB
    itemB = temp
end fun

// -----------------------------------------------------------------
//          END OF DO NOT MODIFY THIS FUNCTION SECTION
// -----------------------------------------------------------------

result = Bubble_Sort(a1)
// comparison counting sort

a1 = arr[1, 10, 5, 6, 4, 7, 19]

fun Comparison_Counting_Sort(arr): 
    n = length(arr)

    count = arr[n]  // create array to store counts
    result = arr[n]  // create result array to be returned

    // initialize the count array
    for (i = 0; i < n; i += 1):
        count[i] = 0
    end for

    // count comparisons
    for (i = 0; i < n - 1; i += 1):
        for (j = i + 1; j < n - 1; j += 1):
            if (arr[i] < arr[j]):
                count[j] += 1
            else:
                count[i] += 1
            end if
        end for
    end for

    // place elements in the sorted array
    for (i = 0; i < n; i += 1):
        result[count[i]] = arr[i]
    end for

    return result

end fun

result = Comparison_Counting_Sort(a1)
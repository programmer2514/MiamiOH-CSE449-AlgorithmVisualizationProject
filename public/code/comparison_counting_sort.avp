// Comparison Counting Sort

a1 = arr[1, 10, 5, 6, 4, 7, 19]

// Sorts an array of values in ascending order
fun Comparison_Counting_Sort(@init<table> array): 
    n = length(array)
    count = arr(n)  // Create array to store counts

    // Compare each number to every other number and count up the comparisons
    @mark<outline, orange> for (i = 0, i < n, i += 1):
        @mark<-999, text, green> @mark<-999, text, red> @mark<outline, blue> for (j = i + 1, j < n, j += 1):
            @mark<j, text> if (array[i] < array[j]):
                @mark<-999, text> @mark<j, text, green, "+1"> count[j] += 1
            else:
                @mark<-999, text> @mark<i, text, red, "+1"> count[i] += 1
            end if
        end for
    end for

    // Place elements back into array
    oldArray = copy(array)
    for (i = 0, i < n, i += 1):
        @mark<count[i], highlight, green> array[count[i]] = oldArray[i]
    end for

    @log<green, "The array is in order!"> return array

end fun

result = Comparison_Counting_Sort(a1)
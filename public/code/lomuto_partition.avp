// lomuto partition

a1 = arr[1, 10, 5, 6, 4, 7, 19]

fun Lomuto_Partition(arr, low, high): 
    // choose the pivot - last element of sub-array
    pivot = arr[high]

    // index of smaller element (boundary for elements < pivot)
    i = low - 1

    for (j = low; j < high; j += 1):
        // check to see if current element is smaller than pivot
        if (arr[j] < pivot):
            i += 1
            swap(arr, i, j) // NOTE: will need to overload swap
        end if
    end for

    swap(arr, i + 1, high)

    return i + 1  // return the high pivot index

end fun

result = Lomuto_Partition(a1, 0, length(arr) - 1)